# Zkopírujte tento soubor jako .env a doplňte hodnoty. Soubor .env se necommituje.

# GEMINI_API_KEY: klíč pro Gemini API (AI rozpočet, vytěžení účtenek).
# Získáte na https://aistudio.google.com/apikey. Používá se pouze na serveru.
GEMINI_API_KEY=""

# GEMINI_MODELS: volitelně čárkou oddělený seznam modelů v pořadí, v jakém se zkouší.
# GEMINI_MODELS="gemini-3.1-flash-lite,gemini-3.8-flash,gemini-flash-latest"

# PORT: port lokálního serveru (výchozí 3000)
# PORT=3000

# STRIPE_SECRET_KEY: Tajný klíč pro Stripe Checkout (sk_test_... nebo sk_live_...)
# Získáte v Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=""

# Volitelné přímé platební odkazy Stripe Payment Links (buy.stripe.com)
VITE_STRIPE_PAYMENT_LINK_MONTHLY=""
VITE_STRIPE_PAYMENT_LINK_YEARLY=""
